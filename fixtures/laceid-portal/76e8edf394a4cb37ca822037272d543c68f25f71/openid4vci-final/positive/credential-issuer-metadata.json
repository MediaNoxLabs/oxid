        "jwt": {
          "proof_signing_alg_values_supported": [
            "EdDSA",
            "ES256"
          ]
        }
      },
      "scope": "digital-passport"
    }
  },
  "credential_endpoint": "https://issuer.example/api/issuer/credentials",
  "credential_issuer": "https://issuer.example",
  "nonce_endpoint": "https://issuer.example/api/issuer/nonce"
}
