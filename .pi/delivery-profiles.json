{
  "schemaVersion": 1,
  "defaultProfile": "production-ready",
  "profiles": {
    "prototype": {
      "remoteMutation": false,
      "mergeEligible": false,
      "evidenceClass": "provisional",
      "maximumReviewers": 1,
      "targets": {
        "required": ["basic"],
        "optionalHostedOnDemand": ["unit-linux", "headless-linux"],
        "maximumFocusedQualifications": 1,
        "neverImplied": [
          "full-nix",
          "ui-linux",
          "ui-release-linux",
          "coverage-linux",
          "quality",
          "nix-package",
          "compact-artifacts",
          "real-portal",
          "real-midnight",
          "desktop",
          "ios",
          "android",
          "physical-device",
          "tailnet",
          "hosted-ci",
          "multi-review"
        ]
      },
      "sloSeconds": {
        "firstFeedback": 180,
        "focusedIteration": 600,
        "workItem": 3600
      },
      "closeoutFields": [
        "hypothesis",
        "result",
        "changedPaths",
        "checksRun",
        "knownGaps",
        "resourceUse",
        "promotionPlan"
      ]
    },
    "production-ready": {
      "remoteMutation": "authority-gated",
      "mergeEligible": "after-required-gates",
      "evidenceClass": "production",
      "maximumReviewers": 1,
      "qualityBudget": {
        "targetPercent": 70,
        "mandatoryInvariantsPercent": 100,
        "maximumAutomaticReviewRounds": 1,
        "advisoryDisposition": "follow-up"
      },
      "targets": {
        "strategy": "path-and-risk",
        "featureCiProfile": "feature"
      }
    }
  },
  "promotion": {
    "explicit": true,
    "refreshBase": "recorded-delivery-base",
    "auditPrototypeGaps": true,
    "invalidateProvisionalEvidence": true,
    "recomputeTargets": true
  },
  "deliveryTarget": {
    "required": true,
    "productPattern": "origin/milestone-<x.y.z>",
    "factoryTarget": "origin/develop",
    "inferNewest": false,
    "sessionLocal": true
  },
  "alwaysEnforced": [
    "issue-backed-worktree",
    "branch-grammar",
    "conventional-commits",
    "dco-signoff",
    "gpg-signing",
    "secret-and-custody-boundaries",
    "process-ownership",
    "disk-bounds"
  ]
}
