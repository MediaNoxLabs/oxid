# Repository-specific dev-loops policy for Oxid.
version: 1

# Stated explicitly rather than inherited. Oxid's spec-of-record is the pull
# request plus its ADRs, and every gate here posts findings onto the PR, so the
# local-first routing is the one that matches where review evidence lives.
strategy:
  default: local-first

refinement:
  fanOut: 3
  mode: parallel
  maxCopilotRounds: 0
  stopOnLowSignal: false
  lowSignalRoundThreshold: 3
  lowSignalMaxComments: 2
  roles:
    - scope
    - correctness
    - coverage
    - architecture
    - security

gates:
  draft:
    angles:
      - scope
      - correctness
      - coverage
      - architecture
      - ci-guard
      - docs
      - config-drift
      - security
      - external-review
    mandatoryAngles:
      - pr-description
      - external-review
    required: true
    requireCi: true
  preApproval:
    angles:
      - correctness
      - coverage
      - architecture
      - ci-guard
      - docs
      - config-drift
      - security
      - external-review
    mandatoryAngles:
      - pr-checklist-matrix
      - external-review
    required: true
    requireCi: true
  requireFanoutEvidence: true
  # Evidence without provenance cannot be audited: a gate that records "five
  # angles reported" but not which reviewer produced which finding cannot be
  # checked for a collapsed panel, where one reviewer's output is replayed under
  # several angle names. Provenance is what makes requireFanoutEvidence
  # falsifiable.
  requireFanoutProvenance: true
  maxFanoutReviewers: 8
  postFindingsComments: true
  rejectForeignAngles: true

personas:
  architecture:
    persona: review
    prompt: >-
      Review dependency direction, Oxid-owned core types, port ownership,
      adapter isolation, composition, and ADR alignment. Report concrete
      findings with file and line references.
    defaultModel: null

  security:
    persona: review
    prompt: >-
      Review secret and identifier exposure, unsafe key boundaries, input
      validation, storage claims, dependency risk, and GitHub workflow safety.
      Report concrete findings with file and line references.
    defaultModel: null

  external-review:
    persona: review
    prompt: >-
      Run an independent Claude CLI review of the exact current head against
      its `origin/integration` merge base. Record a local attestation with the
      Claude CLI version, head SHA, base SHA, exact diff-artifact path, and
      review timestamp; do not claim it authenticates reviewer identity or is a
      hosted/dev-loops-native status. Any push
      makes prior evidence stale. Review correctness, security, architecture,
      tests, documentation, public-repository safety, and regression risk. Do
      not modify files. Return actionable findings with file/line references,
      or No findings.
    defaultModel: null

# The owner authorizes clean integration merges after all current-head gates,
# including the mandatory independent Claude CLI review, have passed and their
# evidence is posted. Override local-first's human-only defaults explicitly;
# no human or CODEOWNERS approval is part of this repository's review control.
autonomy:
  stopAt: []
  humanMergeOnly: false

workflow:
  requireDraftFirst: true
  requireRetrospective: true
  devModeDefault: false

# Deliberately absent, recorded so the gaps are not mistaken for oversights.
#
# models: — per-role model assignment (`models.conductor`, `models.roles`) is
#   the mechanism behind the factory's provider-agnostic goal, but the package
#   ships no defaults and documents no model-identifier format, so any value
#   written here would be a guess that fails at dispatch. Needs one owner
#   decision naming real identifiers; see docs/factory/runbook.md.
#
# worktree: — copyOnInit/linkOnInit provision *gitignored* files into a fresh
#   worktree. Oxid needs none: the Compact and ZK artifact closures arrive as
#   devshell environment exports rather than files, `.envrc` is tracked, and
#   `target/` and `.direnv/` must not be shared between worktrees. The only
#   remaining candidate is `.pi/npm/node_modules`, which the schema explicitly
#   warns against targeting. An empty section would be a no-op, so there is
#   none.
