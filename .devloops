# Repository-specific dev-loops policy for Oxid.
version: 1

# Stated explicitly rather than inherited. Oxid's spec-of-record is the pull
# request plus its ADRs, and every gate here posts findings onto the PR, so the
# local-first routing is the one that matches where review evidence lives.
strategy:
  default: local-first

refinement:
  # Two reviewers are enough to expose a disagreement without turning each
  # iteration into a panel. Keep the pool deliberately smaller than the gate
  # catalog so refinement cannot fan out across every specialist by default.
  fanOut: 2
  mode: parallel
  maxCopilotRounds: 0
  stopOnLowSignal: true
  lowSignalRoundThreshold: 2
  lowSignalMaxComments: 1
  roles:
    - scope
    - correctness

gates:
  draft:
    angles:
      - scope
      - correctness
    mandatoryAngles:
      - pr-description
    required: true
    # The draft gate checks direction before hosted CI has finished. Waiting
    # here made every correction invalidate and repeat both review and CI.
    requireCi: false
  preApproval:
    angles:
      - correctness
      - security
    mandatoryAngles:
      - pr-checklist-matrix
    required: true
    requireCi: true
  requireFanoutEvidence: true
  # Evidence without provenance cannot be audited: a gate that records several
  # angles reported" but not which reviewer produced which finding cannot be
  # checked for a collapsed panel, where one reviewer's output is replayed under
  # several angle names. Provenance is what makes requireFanoutEvidence
  # falsifiable.
  requireFanoutProvenance: true
  maxFanoutReviewers: 2
  postFindingsComments: true
  rejectForeignAngles: true

personas:
  security:
    persona: review
    prompt: >-
      Review secret and identifier exposure, unsafe key boundaries, input
      validation, storage claims, dependency risk, and GitHub workflow safety.
      Report concrete findings with file and line references.
    defaultModel: null

# The active owner may authorize an automated merge only for an issue-backed
# integration PR after the repository merge wrapper passes. Historical main and
# develop remain human-only; releases, settings, tags, and ADR acceptance remain
# human actions.
autonomy:
  stopAt: []
  humanMergeOnly: false

workflow:
  # Permit a small task to stay synchronous. Requiring async start for every
  # change created extra sessions even when no useful parallel work existed.
  asyncStartMode: allowed
  requireDraftFirst: true
  requireRetrospective: false
  devModeDefault: false

localImplementation:
  lightMode:
    enabled: true
    maxFiles: 5
    maxLines: 400
    maxCopilotRounds: 0

queue:
  # One delivery candidate at a time keeps exact-head evidence and hosted CI
  # useful. Additional work may be developed locally, but is not auto-driven.
  maxParallel: 1
  maxAutoFiledIssues: 0
  reDispatchMaxRetries: 0

# Deliberately absent, recorded so the gaps are not mistaken for oversights.
#
# models: — per-role model assignment (`models.conductor`, `models.roles`) is
#   the mechanism behind the factory's provider-agnostic goal, but the package
#   ships no defaults and documents no model-identifier format, so any value
#   written here would be a guess that fails at dispatch. Needs one owner
#   decision naming real identifiers; see docs/factory/runbook.md.
#
# worktree: — copyOnInit/linkOnInit provision *gitignored* files into a fresh
#   worktree. Oxid needs none: the Compact and ZK artifact closures arrive as
#   devshell environment exports rather than files, `.envrc` is tracked, and
#   raw `target/` and `.direnv/` must not be shared between worktrees. The
#   repository worktree wrapper injects an explicit zero-action consumer
#   provisioning policy before the generic provisioning phase can read
#   primary-checkout config or create its dev-loops-monorepo `packages/core`
#   self-link. The runtime resolver reuses the common checkout's `.pi/npm`
#   directly. An empty section would not disable that generic self-link, so
#   there is none.
