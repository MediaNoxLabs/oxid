{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MediaNoxLabs/oxid/integration/docs/factory/work-item-metrics-v1.schema.json",
  "title": "Oxid factory work-item metrics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "issue",
    "pr",
    "headSha",
    "startedAt",
    "completedAt",
    "recordedAt",
    "phases",
    "validations",
    "review",
    "tokens",
    "attempts",
    "ci",
    "worktree",
    "routing"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "const": "MediaNoxLabs/oxid" },
    "issue": { "$ref": "#/$defs/positiveInteger" },
    "pr": {
      "oneOf": [
        { "$ref": "#/$defs/positiveInteger" },
        { "type": "null" }
      ]
    },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "completedAt": { "$ref": "#/$defs/timestamp" },
    "recordedAt": { "$ref": "#/$defs/timestamp" },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["developmentMs", "reviewMs", "validationMs", "ciMs", "totalElapsedMs"],
      "properties": {
        "developmentMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "reviewMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "validationMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "ciMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "totalElapsedMs": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "validations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "durationMs", "outcome"],
        "properties": {
          "name": { "$ref": "#/$defs/metricName" },
          "durationMs": { "$ref": "#/$defs/nonNegativeInteger" },
          "outcome": { "enum": ["passed", "failed", "canceled"] }
        }
      }
    },
    "review": {
      "description": "Exact harness review counters; each counter is null when the active harness does not expose it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions", "turns", "toolCalls", "externalReviewRequired"],
      "properties": {
        "sessions": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "turns": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "toolCalls": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "externalReviewRequired": { "type": "boolean" }
      }
    },
    "tokens": {
      "description": "Exact, non-overlapping harness counters. input excludes cacheRead and cacheWrite; use null when the harness cannot expose that decomposition.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "cacheRead", "cacheWrite"],
          "properties": {
            "input": { "$ref": "#/$defs/nonNegativeInteger" },
            "output": { "$ref": "#/$defs/nonNegativeInteger" },
            "cacheRead": { "$ref": "#/$defs/nonNegativeInteger" },
            "cacheWrite": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        }
      ]
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pushesAfterFirstCi", "canceled", "failed"],
      "properties": {
        "pushesAfterFirstCi": { "$ref": "#/$defs/nonNegativeInteger" },
        "canceled": { "$ref": "#/$defs/nonNegativeInteger" },
        "failed": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "ci": {
      "description": "Exact-head required-check critical-path facts. checks separate provider queue time from runner execution time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["wallTimeMs", "requiredChecks", "failedChecks", "canceledRuns", "checks"],
      "properties": {
        "wallTimeMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "requiredChecks": { "$ref": "#/$defs/nonNegativeInteger" },
        "failedChecks": { "$ref": "#/$defs/nonNegativeInteger" },
        "canceledRuns": { "$ref": "#/$defs/nonNegativeInteger" },
        "checks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "queueMs", "durationMs", "outcome"],
            "properties": {
              "name": { "$ref": "#/$defs/metricName" },
              "queueMs": { "$ref": "#/$defs/nonNegativeInteger" },
              "durationMs": { "$ref": "#/$defs/nonNegativeInteger" },
              "outcome": { "enum": ["passed", "failed", "canceled"] }
            }
          }
        }
      }
    },
    "worktree": {
      "description": "Peak physical worktree bytes without following symlinks or counting common Git/shared-cache storage; target is a subset of the whole worktree.",
      "type": "object",
      "additionalProperties": false,
      "required": ["peakTargetBytes", "peakWorktreeBytes"],
      "properties": {
        "peakTargetBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "peakWorktreeBytes": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "areas", "targets"],
      "properties": {
        "profile": { "enum": ["feature", "integration", "release"] },
        "areas": { "$ref": "#/$defs/metricNames" },
        "targets": {
          "$ref": "#/$defs/hostedTargets"
        }
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
    "nullableNonNegativeInteger": {
      "oneOf": [
        { "$ref": "#/$defs/nonNegativeInteger" },
        { "type": "null" }
      ]
    },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 1000000000000000 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "metricName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$" },
    "metricNames": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/metricName" }
    },
    "hostedTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "enum": [
          "basic",
          "unit-linux",
          "headless-linux",
          "ui-linux",
          "ui-release-linux",
          "coverage-linux",
          "quality",
          "nix-package",
          "compact-artifacts"
        ]
      }
    }
  }
}
